# ==========================================
# Central admin (cpanel_othmane)
# ==========================================
# Where the "Momento" project's server-to-server submissions go: newsletter
# signups, the contact form, and the "become a partner" form. Server-side
# only — never exposed to the browser.
#
# Point this at the central admin instance. Change it later when deploying
# (e.g. https://admin.your-domain.com) — nothing else needs to change.

CENTRAL_ADMIN_URL="http://localhost:4900"

# Shared HMAC secret. Must be the EXACT same value as MOMENTO_API_SECRET in
# the central admin's own .env — it is how the central server verifies these
# requests really come from this site and not an impostor.
#   openssl rand -hex 32

MOMENTO_API_SECRET=""


# ==========================================
# Application (existing)
# ==========================================

NEXT_PUBLIC_BASE_URL="https://momento-artisanal.com"
